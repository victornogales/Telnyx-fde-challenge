# RefillLine Assistant Workflow JSON
# Note: The Portal Workflow UI had a tool-sync bug (MCP tools not appearing in node tool dropdowns),
# so this workflow is created via the Assistants API instead.

POST https://api.telnyx.com/v2/ai/assistants/{assistant_id}

{
  "conversation_flow": {
    "start_node_id": "n_disclosure",
    "nodes": [
      {
        "id": "n_disclosure",
        "type": "speak",
        "message": "Thanks for calling Maple Pharmacy{{greeting_suffix}}. This call may be recorded for quality and safety. I'm an automated assistant; say 'pharmacist' at any time to reach a person."
      },
      {
        "id": "n_triage",
        "type": "prompt",
        "instructions": "Identify the caller's intent. 1. Greet the caller using their first name if available ({{patient_first_name}}). Keep it under 10 seconds. 2. Ask: 'What can I help you with today? You can say refill, status, or general question. And you can say pharmacist at any time.' 3. Wait for the caller's response. 4. Do not verify identity here — route the caller to the right path based on intent. 5. Never forbid tool calls.",
        "instructions_mode": "append"
      },
      {
        "id": "n_verify",
        "type": "prompt",
        "instructions": "Verify the caller's identity by date of birth. Ask the caller for their date of birth. Be warm but direct. Accept flexible formats: 'March fifteenth, nineteen sixty-two', 'fifteen oh three sixty-two', or 'oh three fifteen sixty-two'. Repeat the date back before calling the verify_identity tool: 'You said [date]. Let me check that.' Call verify_identity with: caller = {{telnyx_end_user_target}}, dob = YYYY-MM-DD. After calling the tool, report the outcome naturally. If verified: say 'Thank you, you're verified' and STOP THERE. If not verified: say 'That doesn't match my records. You have {{attempts_left}} more tries.' If locked: say 'For your security, I can't continue on this call. I'll connect you with a pharmacist.' Do not try to be helpful beyond verification.",
        "instructions_mode": "replace"
      },
      {
        "id": "n_refill",
        "type": "prompt",
        "instructions": "Read refill-eligible prescriptions and help the caller choose. Call list_prescriptions with caller = {{telnyx_end_user_target}}, trace_id = {{trace_id}}. Parse the result. Read them back one by one with natural pauses. Ask: 'Which one would you like to refill? You can say the name or the number.' Wait for the caller to choose. If they want multiple, handle one at a time. When the caller picks, route to n_confirm. If the caller says none or never mind, route back to n_triage.",
        "instructions_mode": "append"
      },
      {
        "id": "n_confirm",
        "type": "prompt",
        "instructions": "Read back the choice and get explicit confirmation before refilling. Say: 'You want to refill [medication name] [strength]. Is that correct?' Wait for a clear yes or positive confirmation. Call request_refill with: caller = {{telnyx_end_user_target}}, rx_id = chosen prescription ID, trace_id = {{trace_id}}. If successful: say 'Your refill for [name] is submitted. It will be ready in about 10 minutes. Do you need anything else?' On failure: say 'I couldn't submit that refill right now. Let me connect you with a pharmacist.' On no or negative: say 'No problem. Would you like to choose a different prescription?' and route back to n_refill.",
        "instructions_mode": "append"
      },
      {
        "id": "n_status",
        "type": "prompt",
        "instructions": "Check refill status. Call get_refill_status with caller = {{telnyx_end_user_target}}, trace_id = {{trace_id}}. If there are refills, report each: 'You have [count] refill request[s]. [X] is submitted. [Y] is ready.' If none: 'You don't have any open refills right now.' Ask: 'Do you want to request a refill, or anything else?'",
        "instructions_mode": "append"
      },
      {
        "id": "n_faq",
        "type": "prompt",
        "instructions": "Answer general questions. Available tools: get_pharmacy_info (hours, address, phone), get_medication_info (what a medication is for). For medication questions: call get_medication_info with name and trace_id. Read back only the purpose field — up to 2 sentences. Never give medical advice. Route to pharmacist with 'Let me connect you with a pharmacist for that.'",
        "instructions_mode": "append"
      },
      {
        "id": "n_after_hours",
        "type": "prompt",
        "instructions": "After-hours mode. Say: 'Maple Pharmacy is currently closed. Our hours are {{pharmacy_hours}}.' Offer: 'I can take a callback note for urgent matters, or connect you with our 24-hour pharmacist line.' Use get_pharmacy_info if asked again. Route to transfer on request for a human.",
        "instructions_mode": "append"
      },
      {
        "id": "n_locked",
        "type": "speak",
        "message": "For your security I can't continue verification on this call. I'll connect you with a pharmacist."
      },
      {
        "id": "n_transfer",
        "type": "tool",
        "shared_tool_id": "{transfer_tool_id}",
        "tool_type": "transfer"
      },
      {
        "id": "n_transfer_failed",
        "type": "speak",
        "message": "I couldn't reach a pharmacist right now. Please call back during opening hours: {{pharmacy_hours}}."
      },
      {
        "id": "n_closing",
        "type": "speak",
        "message": "Your refill is in. You'll hear when it's ready. Thanks for calling Maple Pharmacy."
      },
      {
        "id": "n_hangup",
        "type": "tool",
        "shared_tool_id": "{hangup_tool_id}",
        "tool_type": "hangup"
      }
    ],
    "edges": [
      { "id": "e_disclosure_triage", "start_node_id": "n_disclosure", "target": { "type": "node", "node_id": "n_triage" }, "condition": { "type": "default" } },

      { "id": "e_triage_locked", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_locked" }, "condition": { "type": "expression", "comparison": "==", "left": "{{account_locked}}", "right": "true" } },
      { "id": "e_triage_after_hours", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_after_hours" }, "condition": { "type": "expression", "comparison": "==", "left": "{{after_hours_mode}}", "right": "true" } },
      { "id": "e_triage_timeout", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "expression", "comparison": ">=", "left": "{{telnyx_conversation_duration_secs}}", "right": "300" } },
      { "id": "e_triage_refill", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_verify" }, "condition": { "type": "llm", "prompt": "The caller wants to refill a prescription" } },
      { "id": "e_triage_status", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_verify" }, "condition": { "type": "llm", "prompt": "The caller asks whether an order or refill is ready" } },
      { "id": "e_triage_faq", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_faq" }, "condition": { "type": "llm", "prompt": "The caller asks about hours, location, or what a medication is for" } },
      { "id": "e_triage_human", "start_node_id": "n_triage", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "llm", "prompt": "The caller asks for a pharmacist or a human, or is frustrated" } },

      { "id": "e_verify_lockout", "start_node_id": "n_verify", "target": { "type": "node", "node_id": "n_locked" }, "condition": { "type": "expression", "comparison": "==", "left": "{{account_locked}}", "right": "true" } },
      { "id": "e_verify_timeout", "start_node_id": "n_verify", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "expression", "comparison": ">=", "left": "{{telnyx_conversation_duration_secs}}", "right": "300" } },
      { "id": "e_verify_human", "start_node_id": "n_verify", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "llm", "prompt": "The caller asks for a human or pharmacist" } },
      { "id": "e_verify_refill", "start_node_id": "n_verify", "target": { "type": "node", "node_id": "n_refill" }, "condition": { "type": "llm", "prompt": "The caller was verified and wants to refill a prescription" } },
      { "id": "e_verify_status", "start_node_id": "n_verify", "target": { "type": "node", "node_id": "n_status" }, "condition": { "type": "llm", "prompt": "The caller was verified and wants to check refill status" } },

      { "id": "e_refill_confirm", "start_node_id": "n_refill", "target": { "type": "node", "node_id": "n_confirm" }, "condition": { "type": "llm", "prompt": "The caller has chosen which prescription(s) to refill" } },
      { "id": "e_refill_triage", "start_node_id": "n_refill", "target": { "type": "node", "node_id": "n_triage" }, "condition": { "type": "llm", "prompt": "Nothing is eligible or the caller changes their mind" } },
      { "id": "e_refill_timeout", "start_node_id": "n_refill", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "expression", "comparison": ">=", "left": "{{telnyx_conversation_duration_secs}}", "right": "300" } },

      { "id": "e_confirm_closing", "start_node_id": "n_confirm", "target": { "type": "node", "node_id": "n_closing" }, "condition": { "type": "llm", "prompt": "The refill was submitted successfully" } },
      { "id": "e_confirm_refill", "start_node_id": "n_confirm", "target": { "type": "node", "node_id": "n_refill" }, "condition": { "type": "llm", "prompt": "The caller said no or wants to make changes" } },
      { "id": "e_confirm_timeout", "start_node_id": "n_confirm", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "expression", "comparison": ">=", "left": "{{telnyx_conversation_duration_secs}}", "right": "300" } },

      { "id": "e_status_closing", "start_node_id": "n_status", "target": { "type": "node", "node_id": "n_closing" }, "condition": { "type": "llm", "prompt": "The caller is done" } },
      { "id": "e_status_refill", "start_node_id": "n_status", "target": { "type": "node", "node_id": "n_refill" }, "condition": { "type": "llm", "prompt": "The caller wants to request a refill" } },

      { "id": "e_faq_verify", "start_node_id": "n_faq", "target": { "type": "node", "node_id": "n_verify" }, "condition": { "type": "llm", "prompt": "The caller wants a refill or status" } },
      { "id": "e_faq_closing", "start_node_id": "n_faq", "target": { "type": "node", "node_id": "n_closing" }, "condition": { "type": "llm", "prompt": "The caller is done" } },
      { "id": "e_faq_transfer", "start_node_id": "n_faq", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "llm", "prompt": "The caller asks for a human or pharmacist" } },

      { "id": "e_locked_transfer", "start_node_id": "n_locked", "target": { "type": "node", "node_id": "n_transfer" }, "condition": { "type": "default" } },

      { "id": "e_transfer_failed", "start_node_id": "n_transfer", "target": { "type": "node", "node_id": "n_transfer_failed" }, "condition": { "type": "default" } },
      { "id": "e_transfer_failed_hangup", "start_node_id": "n_transfer_failed", "target": { "type": "node", "node_id": "n_hangup" }, "condition": { "type": "default" } },

      { "id": "e_closing_hangup", "start_node_id": "n_closing", "target": { "type": "node", "node_id": "n_hangup" }, "condition": { "type": "default" } }
    ]
  }
}

# Tool scoping (to be set per node via API or Portal):
# - n_verify: verify_identity
# - n_refill: list_prescriptions
# - n_confirm: request_refill
# - n_status: get_refill_status
# - n_faq: get_pharmacy_info, get_medication_info
# - n_after_hours: get_pharmacy_info
# - n_transfer: transfer
# - n_hangup: hangup
